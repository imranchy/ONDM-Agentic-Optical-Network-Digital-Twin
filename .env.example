# Copy to .env (gitignored) and fill in. Never commit real tokens.
NETBOX_URL=http://localhost:8000
# Read-only NetBox API token used by the app / VLM tools (NetBox 4.7 v2 token: nbt_<key>.<secret>)
NETBOX_TOKEN=
# Write token used ONLY by scripts/netbox_synthetic_inventory.py (import / rollback)
NETBOX_WRITE_TOKEN=

# VLM (Ollama). Default: qwen3-vl:8b-instruct
ONDM_VLM_BACKEND=ollama
ONDM_VLM_MODEL=qwen3-vl:8b-instruct
OLLAMA_HOST_URL=http://localhost:11434
ONDM_VLM_NUM_CTX=16384

# Code sandbox (Docker image built from sandbox/Dockerfile)
ONDM_SANDBOX_IMAGE=ondm-sandbox:latest
ONDM_SANDBOX_TIMEOUT_S=20
ONDM_MAX_CODE_ATTEMPTS=3
